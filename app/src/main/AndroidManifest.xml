<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.ContactCaseStyler">

        <!-- Real screen. No launcher intent here on purpose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
        </activity>

        <!-- Launcher entry as a detachable alias, so "Hide icon"
             can switch it off while the tile keeps working. -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@android:mipmap/sym_def_app_icon"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Quick Settings tile: the tweak-feel entry point. -->
        <service
            android:name=".StylerTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
